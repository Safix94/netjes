{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] },
    "opener:allow-reveal-item-in-dir",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://www.agentiek.be/*" }, { "url": "https://github.com/*" }] }
  ]
}
